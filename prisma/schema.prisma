generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Device {
  id           String      @id // Anonymous device UUID generated by mobile client
  appVersion   String
  deviceModel  String?     // e.g. Samsung SM-S928B, Google Pixel 8
  osVersion    String?     // e.g. Android 14 (API 34)
  countryCode  String?     // e.g. US, BD, DE
  cpuArch      String?     // e.g. arm64-v8a
  firstSeenAt  DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())
  isActive     Boolean     @default(true)
  heartbeats   Heartbeat[]

  @@index([lastSeenAt])
  @@index([countryCode])
  @@map("devices")
}

model Heartbeat {
  id               String   @id @default(uuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  selectedProvider String
  shieldEnabled    Boolean  @default(false)
  totalQueries     Int      @default(0)
  blockedQueries   Int      @default(0)
  timestamp        DateTime @default(now())

  @@index([deviceId])
  @@index([timestamp])
  @@map("heartbeats")
}

model DnsServerConfig {
  id          String   @id @default(uuid())
  name        String
  primaryIp   String
  secondaryIp String?
  hostname    String?
  dohUrl      String?
  category    String   @default("PUBLIC")
  isDefault   Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dns_server_configs")
}

model BlocklistConfig {
  id          String   @id @default(uuid())
  name        String
  url         String
  category    String   @default("ADS")
  description String?
  ruleCount   Int      @default(0)
  isEnabled   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blocklist_configs")
}
