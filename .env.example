# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@hostname/database?sslmode=require"

# Security & Client Authentication (Generate 64-char hex strings)
CLIENT_API_KEY="your-random-64-character-client-api-key"
JWT_SECRET="your-random-96-character-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
